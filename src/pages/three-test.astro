<body style="margin: 0;">
    <script>
        import * as THREE from "three";

        const scene = new THREE.Scene();
        const camera = new THREE.PerspectiveCamera(75, window.innerWidth / window.innerHeight, .4, 1000);

        const renderer = new THREE.WebGLRenderer();

        document.body.appendChild(renderer.domElement);
        renderer.setSize(window.innerWidth, window.innerHeight);

        window.addEventListener("resize", () => resize_camera(window.innerWidth, window.innerHeight));

        function resize_camera(w: number, h: number) {
            console.log("adjusting renderer size... [w,h]", [w, h]);
            renderer.setSize(w, h);
            camera.aspect = w / h;
            camera.updateProjectionMatrix();
        }

        const geometry = new THREE.BoxGeometry(1, 1, 1);
        const material = new THREE.MeshBasicMaterial({ color: 0x00ff00 });

        const parent = new THREE.Group();

        const cubes: THREE.Mesh[] = [];

        for (let index = 0; index < Math.pow(8, 3); index++) {
            const mat = material.clone();
            mat.color.setRGB(Math.random(), Math.random(), Math.random());
            
            const cube = new THREE.Mesh(geometry, mat);
            parent.add(cube);
            cubes.push(cube);
        }
        parent.scale.setScalar(0.5);

        scene.add(parent);

        camera.position.z = 5;

        renderer.setAnimationLoop(animate);

        let counter = 0;

        function animate() {
            const SPEED = 0.005;
            parent.rotation.x += SPEED;
            parent.rotation.y += SPEED;
            set_layout_grid((Math.sin(counter) + 1) * 2.5 + 0.1, 0.01);
            renderer.render(scene, camera);
        }

        setInterval(() => {
            counter += 1;
        }, 3 * 1000);

        function set_layout_grid(gap = 0.1, t = 1) {
            const n = Math.ceil(Math.pow(cubes.length, 1 / 3));

            for (let x = 0; x < n; x++) {
                for (let y = 0; y < n; y++) {
                    const xy = x * n + y;
                    for (let z = 0; z < n; z++) {
                        const index = xy * n + z;

                        if (index > cubes.length - 1) return;

                        const cube = cubes[index];
                        const px = (x - n / 2 + 0.5) * (1 + gap);
                        const py = (y - n / 2 + 0.5) * (1 + gap);
                        const pz = (z - n / 2 + 0.5) * (1 + gap);

                        const tx = THREE.MathUtils.lerp(cube.position.x, px, t);
                        const ty = THREE.MathUtils.lerp(cube.position.y, py, t);
                        const tz = THREE.MathUtils.lerp(cube.position.z, pz, t);

                        cube.position.setX(tx);
                        cube.position.setY(ty);
                        cube.position.setZ(tz);

                        
                    }
                }
            }
        }
    </script>
</body>
