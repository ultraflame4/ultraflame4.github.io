---
import Layout from "@/layouts/Layout.astro";
import NavDock from "@/components/NavDock.astro";
import { normalise_FrontmatterProjectData } from "@/lib/project_utils";
import { getCollection, render } from "astro:content";
import { SpotlightBackground, TypedText, Typewriter, WindowEntryRatio } from "@/components/effects";
import BackToTop from "@/components/BackToTop.astro";
import ProjectCardStatic from "@/components/ui/project/ProjectCardStatic.astro";
import LandingBannerBg from "@/components/ui/landing/LandingBannerBg.astro";

const _projects = await getCollection("projects");

const projects_rendered = await Promise.all(
    _projects
        .map((x) => ({
            data: normalise_FrontmatterProjectData(x.data, x.body ?? "", x.filePath),
            og: x,
        }))

        .toSorted((a, b) => {
            // Sort by end_date (desc), then start_date (desc)
            const aEnd = (a.data.end_date ?? a.data.start_date)?.getTime();
            const bEnd = (b.data.end_date ?? b.data.start_date)?.getTime();
            return (bEnd ?? 0) - (aEnd ?? 0);
        })
        .map((x) =>
            render(x.og).then((r) => ({
                data: x.data,
                content: r.Content,
            }))
        )
);

const title = new TypedText().wait(500).seq("The ").styled_seq("Gallery", { class: "text-rainbow" }).build();
const subtitle = new TypedText().wait(1500).seq("Collection of all my projects").build();
---

<Layout>
    <div class="absolute top-0 w-full bg-black" style="height: 100svh; z-index: -1;">
        <div class="noise"></div>
        <LandingBannerBg />
        <div class="absolute h-full w-full top-0 left-0"></div>
    </div>

    <section>
        <div
            class="w-full flex flex-col justify-center items-center z-10"
            style="height: calc(100svh - var(--nav-total-h-units) );"
        >
            <h1 class="font-fancy text-6xl p-2 rounded-lg glow mb-2 min-h-[1.5em]">
                <Typewriter instructions={title.instructs} fallback={title.fallback} interval={50} client:load />
            </h1>
            <p class="mb-8 min-h-[1.5em] font-black text-xl font-cursive">
                <Typewriter
                    instructions={subtitle.instructs}
                    fallback={subtitle.fallback}
                    interval={20}
                    hideCursor
                    client:load
                />
            </p>
        </div>

        <NavDock />

        <WindowEntryRatio class="relative w-full h-0" client:load>
            <div class="banner-trans h-svh"></div>
        </WindowEntryRatio>
        <style>
            @import "@styles/global.css";
            .banner-trans {
                @apply absolute bottom-0 w-full bg-background;
                opacity: min(calc(calc(var(--ratio) * 1.5) + 0.3), 0.9);
            }
        </style>

        <div class="w-full px-4 py-2 flex min-w-0">
            <div class="m-auto gap-px p-[1.2px] project-grid min-w-0 relative">
                {
                    projects_rendered.map((x) => {
                        return (
                            <ProjectCardStatic data={x.data}>
                                <x.content />
                            </ProjectCardStatic>
                        );
                    })
                }
                <div class="bg-background min-h-32 grid-filler"></div>
                <!-- Need this here to act as the base background. Setting it on the parent element will fuck up the spotlight bg due to the z index -->
                <div class="absolute inset-0 -z-10 bg-highlight"></div>
                <SpotlightBackground client:only class="absolute inset-0 -z-10" />
            </div>
        </div>
        <script is:inline define:vars={{ project_count: projects_rendered.length }}>
            function updateCols() {
                const grid = document.querySelector(".project-grid");
                const filler = document.querySelector(".grid-filler");
                console.log("eles", grid, filler);
                if (!grid) return;
                if (!filler) return;
                const computedStyle = getComputedStyle(grid);
                const columnCount = computedStyle.gridTemplateColumns.split(" ").length;

                const remainder = project_count % columnCount;

                if (remainder > 0) {
                    const col_span = columnCount - remainder;
                    filler.style.gridColumn = `span ${col_span}`;
                    filler.style.display = "block";
                } else {
                    filler.style.display = "none";
                }
            }

            window.addEventListener("resize", updateCols);
            document.addEventListener("pathchanged", updateCols);
        </script>
    </section>
    <!-- <UnderConstruction /> -->
    <BackToTop />
</Layout>
<style>
    @import "@styles/global.css";

    section > h1 {
        @apply font-fancy text-3xl mb-3;
    }

    section {
        @apply flex items-center justify-center flex-col;
    }

    .project-grid {
        display: grid;
        width: min(100%, 160rem);
        grid-template-columns: repeat(auto-fit, minmax(min(100%, 42rem), 1fr));
    }
</style>
