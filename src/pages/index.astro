---
import TypedTextEffect, {
    tte_goto,
} from "@components/effects/TypedTextEffect.vue";
import LandingPageTerminal from "@components/effects/LandingPageTerminal.vue";
import Layout from "@layouts/Layout.astro";

let rand_color = 1;

const greeting = [
    10,
    "Hello There,",
    "Hello There,\nI am Chester,",
    20,

    `Hello There,\nI am Chester,\n I am a <span style='color:#FDE68A'>Learner</span>`,
    20,
    `Hello There,\nI am Chester,\n I am a <span style='color:#86EFAC'>Gamer</span>`,
    20,
    `Hello There,\nI am Chester,\n I am a <span style='color:#A78BFA'>Programmer</span>`,
    20,
    `Hello There,\nI am Chester,\n I am a <span style='color:#FACC15'>Worker</span>`,
    20,
    `Hello There,\nI am Chester,\n I am <span style='color:#A5F3FC'>Chester</span>`,
    40,
    tte_goto(3),
];
---

<Layout>
    <div
        class="absolute top-0 w-full banner-bg"
        style="height: 210vh; z-index: -1;"
    >
        <div class="noise"></div>
        <div class="p-16 top-0 sticky h-dvh w-2/3 ml-auto text-sm">
            <LandingPageTerminal client:only />
        </div>

    </div>

    <section>
        <div class="w-full flex relative" id="banner" style="height: calc(100vh + calc(var(--spacing) * 16));">
            <div
                class="
                flex items-center justify-cente flex-col relative
                bg-overlay
                "
                id="greetings"
            >
                <h1
                    class="font-fancy text-4xl p-2 rounded-lg w-md sticky top-1/2 -translate-y-1/2 glow"
                >
                    <TypedTextEffect texts={greeting} client:only />
                </h1>
            </div>
  
        </div>

        <style>
            #banner {
                display: grid;
                grid-template-columns: 1fr 2fr;
            }

            .noise {
                position: absolute;
                inset: 0;
                background: url("/noise.svg");
                background-size: 100px;
                filter: contrast(400%) brightness(50%) invert(1) grayscale(1);

                mix-blend-mode: multiply;
            }

            .banner-bg {
                background-color: #4158d0;
                background-image: linear-gradient(
                    43deg,
                    #4158d0 0%,
                    #c850c0 46%,
                    #ffcc70 100%
                );
            }
        </style>
    </section>
    <div class="relative w-full h-0">
        <div class="absolute bottom-0 w-full h-16 bg-linear-0 from-surf1 to-transparent "></div>
    </div>
    <section class="bg-surf1">
