---
import TypedTextEffect, {
    tte_goto,
} from "@components/effects/TypedTextEffect.vue";
import LandingPageTerminal from "@components/effects/LandingPageTerminal.vue";
import Layout from "@layouts/Layout.astro";

let rand_color = 1;

const greeting = [
    10,
    "Hello There,",
    "Hello There,\nI am Chester,",
    20,

    `Hello There,\nI am Chester,\n I am a <span style='color:#FDE68A'>Learner</span>`,
    20,
    `Hello There,\nI am Chester,\n I am a <span style='color:#86EFAC'>Gamer</span>`,
    20,
    `Hello There,\nI am Chester,\n I am a <span style='color:#A78BFA'>Programmer</span>`,
    20,
    `Hello There,\nI am Chester,\n I am a <span style='color:#FACC15'>Worker</span>`,
    20,
    `Hello There,\nI am Chester,\n I am <span style='color:#A5F3FC'>Chester</span>`,
    40,
    tte_goto(3),
];
---

<Layout>
    <div class="absolute top-0 w-full banner-bg" style="height: 180vh; z-index: -1;">
        <div class="p-16 top-0 sticky h-dvh w-2/3 ml-auto text-sm">
            <LandingPageTerminal client:only />
        </div>
    </div>

    <section>
        <div class="w-full h-dvh flex" id="banner">
            <div
                class="flex items-center justify-center bg-overlay flex-col relative"
                id="greetings"
            >
                <div class="noise"></div>
                <h1 class="font-fancy text-4xl p-2 rounded-lg w-md">
                    <TypedTextEffect texts={greeting} client:only />
                </h1>
            </div>
        </div>
        <style>
            #banner {
                display: grid;
                grid-template-columns: 1fr 2fr;
            }

            .noise {
                position: absolute;
                inset: 0;
                background: url("/noise.svg");
                background-size: 100px;
                /* filter: contrast(400%) brightness(100%) invert(1) grayscale(1); */
                opacity: 0.1;
                mix-blend-mode: screen;
            }

            #greetings h1 {
                filter: drop-shadow(0 0 48px #fff);
            }

            .banner-bg {
                background-color: #4158d0;
                background-image: linear-gradient(
                    43deg,
                    #4158d0 0%,
                    #c850c0 46%,
                    #ffcc70 100%
                );
            }
        </style>
    </section>
    <section class="bg-surf0">
        <h1>About</h1>
