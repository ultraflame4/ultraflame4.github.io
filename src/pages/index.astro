---
import TypedTextEffect, {
    tte_goto,
} from "@components/effects/TypedTextEffect.vue";
import LandingPageTerminal from "@components/effects/LandingPageTerminal.vue";
import Layout from "@layouts/Layout.astro";

let rand_color = 1;

const greeting = [
    10,
    "Hello There,",
    "Hello There,\nI am Chester,",
    20,
    
    `Hello There,\nI am Chester,\n I am a <span style='color:#FDE68A'>Learner</span>`,
    20,
    `Hello There,\nI am Chester,\n I am a <span style='color:#86EFAC'>Gamer</span>`,
    20,
    `Hello There,\nI am Chester,\n I am a <span style='color:#A78BFA'>Programmer</span>`,
    20,
    `Hello There,\nI am Chester,\n I am a <span style='color:#FACC15'>Worker</span>`,
    20,
    `Hello There,\nI am Chester,\n I am <span style='color:#A5F3FC'>Chester</span>`,
    40,
    tte_goto(3),
];
---

<Layout>
    <section>
        <div class="w-full p-16 h-dvh flex relative" id="banner">
            <div class="noise"></div>

            <div class="w-full h-full" style="z-index: 1;">
                <LandingPageTerminal client:only />
            </div>
            <div
                class="absolute top-0 left-0 w-full h-full flex items-center justify-center bg-overlay"
                style="z-index: 1;"
            >
                <h1 class="font-fancy text-3xl p-2 rounded-lg" id="greetings">
                    <TypedTextEffect texts={greeting} client:only />
                </h1>
            </div>
        </div>
    </section>
    <section>
        <h1>About</h1>
    </section>
</Layout>
<style>
    @import "@styles/global.css";

    section > h1 {
        @apply font-fancy text-3xl m-4;
    }

    section {
        @apply flex items-center justify-center;
    }

    .noise {
        position: absolute;
        left: 0;
        right: 0;
        top: 0;
        bottom: 0;

        z-index: 0;
        background: url("/noise.svg");
        filter: contrast(100%) brightness(100%);
        background-size: 100px;
        mix-blend-mode: screen;
    }
    #banner {
        background-color: #4158d0;
        background-image: linear-gradient(
            43deg,
            #4158d0 0%,
            #c850c0 46%,
            #ffcc70 100%
        );
    }

    #greetings {
        filter: drop-shadow(0 0 48px #fff);
    }

    #greetings :global(.human) {
        @apply text-emerald-300;
    }
    #greetings :global(.student) {
        @apply text-amber-300;
    }
    #greetings :global(.programmer) {
        @apply text-blue-300;
    }
    #greetings :global(.software) {
        @apply text-violet-300;
    }
</style>
