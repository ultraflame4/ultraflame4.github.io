---
import Layout from "@/layouts/Layout.astro";
import NavDock from "@/components/NavDock.astro";
import UserArticles from "@/components/ui/DevTo/UserArticles.vue";
import PageHeader from "@/components/PageHeader.astro";
import { TypedText, Typewriter } from "@/components/effects";
import CubeBannerBg from "@/components/ui/landing/CubeBannerBg.astro";

const title = new TypedText().wait(500).seq("The B").styled_seq("log.txt", { class: "text-rainbow" }).build();
const subtitle = new TypedText().wait(1400).seq("Devlogs, Updates, Posts & random thoughts").build();
const subtitle2 = new TypedText()
    .wait(3500)
    .seq("> sudo ")
    .wait(10)
    .seq("journalctl ")
    .wait(300)
    .seq("-t ")
    .wait(300)
    .seq("daily ")
    .wait(300)
    .seq("-n 1000")
    .build();
---

<Layout>
    <PageHeader>
        <CubeBannerBg slot="background" />
        <div class="w-full h-full flex flex-col items-center justify-center">
            <h1 class="font-fancy text-6xl p-2 rounded-lg glow mb-2 min-h-[1.5em]">
                <Typewriter instructions={title.instructs} fallback={title.fallback} interval={50} client:load />
            </h1>
            <p class="mb-8 min-h-[1.5em] font-black text-lg font-mono">
                <Typewriter
                    instructions={subtitle.instructs}
                    fallback={subtitle.fallback}
                    interval={20}
                    hideCursor
                    client:load
                />
            </p>
            <p class="mt-8 min-h-[1.5em] font-black text-xs font-mono bg-background">
                <Typewriter
                    instructions={subtitle2.instructs}
                    fallback={subtitle2.fallback}
                    hideCursor
                    interval={30}
                    client:load
                />
            </p>
        </div>
        <NavDock slot="navbar" />
    </PageHeader>

    <section class="px-4">
        <UserArticles username="clyh" client:load />

        <p class="text-dimmed text-xs font-mono font lowercase mt-4">
            view all posts at <a href="https://dev.to/clyh">dev.to/clyh</a>
        </p>
    </section>
</Layout>
<style>
    @import "@styles/global.css";

    section > h1 {
        @apply font-fancy text-3xl mb-3;
    }
    section a {
        @apply underline hover:text-primary;
    }
    section {
        @apply flex items-center justify-center flex-col;
    }
</style>
