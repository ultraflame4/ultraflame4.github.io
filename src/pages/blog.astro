---
import Layout from "@/layouts/Layout.astro";
import NavDock from "@/components/NavDock.astro";
import UnderConstruction from "@/components/UnderConstruction.astro";
import { RSSFeedViewer } from "@/components/ui";
import UserArticles from "@/components/ui/DevTo/UserArticles.vue";
import SpotlightBackground from "@/components/effects/SpotlightBackground.vue";
---

<Layout>
    <NavDock />
    <section class="px-4">
        <h1>Recent Posts</h1>
        <SpotlightBackground client:only class="px-px w-full  xl:w-7xl ">
            <UserArticles username="clyh" client:load />
        </SpotlightBackground>
        <p class="text-dimmed text-xs font-mono font lowercase mt-4">
            view all posts at <a href="https://dev.to/clyh">dev.to/clyh</a>
        </p>
    </section>
</Layout>
<style>
    @import "@styles/global.css";

    section > h1 {
        @apply font-fancy text-3xl mb-3;
    }
    section a {
        @apply underline hover:text-primary;
    }
    section {
        @apply flex items-center justify-center flex-col;
    }
</style>
