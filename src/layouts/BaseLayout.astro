import '@fontsource/poppins'
import '@fontsource/poppins'
import '@fontsource-variable/dancing-script'

import "../styles/global.css";

import { ClientRouter } from "astro:transitions";
---

<!doctype html>
<html lang="en">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width" />
        <link rel="icon" type="image/svg+xml" href="/logov200.png" />
        <meta name="generator" content={Astro.generator} />
        <title>clyh's place</title>
        <script src="https://code.iconify.design/iconify-icon/3.0.0/iconify-icon.min.js"></script>
        <ClientRouter />
        <script>
            import { init_pathchange_detection } from "@/components/core";
            import { initYoutubeApi } from "@/lib/external/yt";

            init_pathchange_detection();
            initYoutubeApi();
        </script>
        <style define:vars={{ noise_url: `url("${import.meta.env.BASE_URL}/noise.svg")` }}>
            .noise {
                position: absolute;
                inset: 0;
                background: var(--noise_url);
                background-size: 100px;
                filter: contrast(400%) brightness(50%);

                mix-blend-mode: multiply;
            }
        </style>
    </head>
    <body id="top" class="min-h-[100dvh] flex flex-col">
        <noscript>
            <p class="fixed top-0 bg-danger text-white z-40 w-full text-center text-sm font-mono p-2">
                Warning, javascript disabled! Certain functions will be broken! <a
                    class="underline"
                    href="https://www.enable-javascript.com/">Enable Javascript</a
                >
            </p>
        </noscript>
        <slot />
    </body>
</html>

<style>
    html,
    body {
        margin: 0;
        width: 100%;
    }
</style>
