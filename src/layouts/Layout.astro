---
import { PulseRotatingBg } from "@/components/effects";
import BaseLayout from "@layouts/BaseLayout.astro";
import socials from "@data/socials.json";
import { Icon } from "@iconify/vue";

const version = import.meta.env.__APP_VERSION__;
const commit_hash = import.meta.env.__COMMIT_HASH__;
const mode_s = import.meta.env.MODE;
---

<BaseLayout>
    <main class="grow">
        <slot />
    </main>

    <footer class="mt-4 pt-2 relative overflow-hidden" id="bottom">
        <div class="min-h-12.5 pt-2 px-4 items-center justify-center text-sm relative site-meta">
            <div class=" col-span-3 mb-2">
                <style>
                    img {
                        margin-right: calc(1 * var(--spacing))
                    }
                </style>
                <ul class="h-8 flex items-center overflow-y-hidden w-max animate-marquee">
                    {
                        [0,1].map(()=>(
                        <img src="/badges-external/88x31pinkmarble.gif" alt="badge" />
                        <img src="/badges-external/97x31_wwwbutton.gif" alt="badge" />
                        <img src="/badges-external/affection.gif" alt="badge" />
                        <img src="/badges-external/css.gif" alt="badge" />
                        <img src="/badges-external/danckity.gif" alt="badge" />
                        <img src="/badges-external/dootdoot.gif" alt="badge" />
                        <img src="/badges-external/got_html.gif" alt="badge" />
                        <img src="/badges-external/pensioner.gif" alt="badge" />
                        <img src="/badges-external/site_best_viewed_with_monitor.gif" alt="badge" />
                        <img src="/badges-external/yeah.gif" alt="badge" />
                        <img src="/badges-external/milkteaNOW.jpg" alt="badge" />
                        <img src="/badges-external/100percenthuman.png" alt="badge" />
                        <img src="/badges-external/ilikecomputer.png" alt="badge" />
                        <img src="/badges-external/myown2paws.png" alt="badge" />
                        <img src="/badges-external/game_over.webp" alt="badge" />
                        <img src="/badges-external/nyan_cat.webp" alt="badge" />
                        ))
                    }

                </ul>
            </div>

            <code class="bg-black px-1.5 rounded-md block w-fit site-version">
                <!-- <pre>Site Version { version } </pre> -->
                <pre>Site Version { version } {commit_hash ? `${commit_hash}` :""}</pre>
            </code>
            <div class="flex items-center gap-2 justify-center bar-center">
                <span> Made with ❤️ by ultr42 </span>
                <span>|</span>
                <span> © Copyright 2026</span>
            </div>
            <div class="flex items-center justify-end social-list h-full gap-2 px-2">
                {
                    socials.map((x) => (
                        <a title={x.title} href={x.url} class="hover:text-accent">
                            <iconify-icon ssr icon={x.iconify} class="text-2xl" />
                        </a>
                    ))
                }
            </div>

            <PulseRotatingBg class:list={["opacity-60"]} />
        </div>
    </footer>
</BaseLayout>

<style>
    @reference "@/styles/global.css";
    footer {
        border-top: 1px solid var(--color-panel);
    }

    .site-meta {
        background: linear-gradient(180deg, var(--color-background) 0%, transparent 100%);
        display: grid;
        grid-template-columns: 1fr auto 1fr;
        @apply pb-2;
    }

    @media screen and (max-width: 850px) {
        .site-meta {
            @apply w-full pb-2;
            grid-template-columns: 1fr;
            grid-template-rows: repeat(3, 1fr);
        }
        .social-list,
        .site-version {
            @apply mx-auto;
        }
    }
</style>
