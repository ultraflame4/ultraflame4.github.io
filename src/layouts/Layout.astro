---
import NavDock from "@/components/NavDock.astro";
import BaseLayout from "@layouts/BaseLayout.astro";
---

<BaseLayout>
    <slot />

    <footer class="mt-32 pt-8 relative overflow-hidden">
        <div class="h-10 flex items-center justify-center text-sm gap-1">
            <code class="bg-black px-1.5 rounded-md">
                <pre>Site Version 7.0.0-dev</pre>
            </code>
            © Copyright 2025, ultraflame4.github.io All rights reserved.
        </div>
        <div class="rainbow-bar h-8"></div>

        <style>
            footer {
                border-top: 1px solid var(--color-panel);
            }

            .rainbow-bar {
                background: black;
                filter: drop-shadow(0px -2px 6px var(--color-rainbow));
                position: absolute;
                top: 100%;
                left: -10%;
                right: -10%;
                z-index: -1;
            }
        </style>
    </footer>
</BaseLayout>
