---
const links = {
    about: "/about",
    skills: "/skills",
    gallery: "/gallery",
};
---

<div class="flex items-center justify-center w-full h-12 fixed bottom-0 mb-4" >
    <div
        class="flex items-center justify-center h-full rounded-2xl drop-shadow-xl bg-bg-surf0 p-2 gap-2.5"
    >
        <div class="h-full">
            <a href="/" class="nav-brand" data-active={Astro.url.pathname == "/"}>
                <img src="/logov300.png" class="h-full"  />
            </a>
        </div>
        <nav>
            <ul class="list-none flex gap-2.5 font-fancy uppercase text-white">
                {
                    Object.entries(links).map(([k, v]) => (
                        <li class="hover:text-accent cursor-pointer data-[active=true]:text-rainbow transition duration-1000 ease-in-out" data-active={Astro.url.pathname == v}>
                            <a href={v}>{k}</a>
                        </li>
                    ))
                }
            </ul>
        </nav>
    </div>
</div>

<style>
    @reference "@styles/global.css";
    .nav-brand[data-active="true"] > img, nav li[data-active="true"]{
        filter: drop-shadow( 0px 0px 2px var(--color-rainbow));
    }
</style>
