---

const { class: className, ...rest } = Astro.props;
const links = {
    about: "/about",
    skills: "/skills",
    gallery: "/gallery",
};
---

<div class="p-4 w-full sticky top-0 z-10" >
    <div
        class="flex items-center justify-center h-12 rounded-2xl drop-shadow-xl acrylic px-4 py-2 w-fit m-auto"
    >

        <nav class="h-full">
            <ul class="list-none flex gap-2.5 font-fancy uppercase h-full text-dimmed items-center justify-center">
                <li class="h-full">
                    <a href="/" class="nav-brand" data-active={Astro.url.pathname == "/"}>
                        <img src="/logov300.png" class="h-full"  />
                    </a>
                </li>
                {
                    Object.entries(links).map(([k, v]) => (
                        <li class="navlink hover:text-accent cursor-pointer " data-active={Astro.url.pathname == v}>
                            <a href={v}>{k}</a>
                        </li>
                    ))
                }
            </ul>
        </nav>
    </div>
</div>

<style>
    @reference "@styles/global.css";
    
    .nav-brand > img, nav li{
        transition: all 200ms ease;
        @apply text-bright
    }

    .nav-brand[data-active="true"] > img, nav li[data-active="true"]{
        filter: drop-shadow( 0px 0px 2px var(--color-rainbow));
        @apply text-crust
    }

</style>
