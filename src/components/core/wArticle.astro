---
// Special compnent that finds all anchor tags that hrefs to this and applies data-active attribute to them when visible

const { id } = Astro.props;
---

<article id={id}>
    <slot />
</article>

<script define:vars={{ id }}>
    const article = document.getElementById(id);

    if (!article) {
        throw new Error(`Article #${id} not found`);
    }

    const links = document.querySelectorAll(`a[href="#${CSS.escape(id)}"]`);

    const observer = new IntersectionObserver(
        ([entry]) => {
            const active = entry.intersectionRatio >= 0.5;
            links.forEach((link) => {
                link.toggleAttribute("data-active", active);
            });
        },
        {
            threshold: [0.5],
            rootMargin: "-20% 0px -20% 0px",
        },
    );

    observer.observe(article);
</script>
